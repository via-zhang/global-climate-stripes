# Public HTTPS folder that holds the data manifest.json (must end in "/").
# Copy to .env.production.local and fill in. Required for `npm run build` / `npm run deploy`.
# In `npm run dev` the app falls back to working/tiles/berkeley-earth-hr/v1/ when this is unset.
VITE_DATA_URL=https://data.example.com/berkeley-earth-hr/v1/
